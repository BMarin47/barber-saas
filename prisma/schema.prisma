// Prisma schema file for SQLite / Tech Minimalist BarberSaaS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id               String   @id @default(cuid())
  clientName       String   // Nombre y apellido
  clientPhone      String   // Teléfono / WhatsApp
  serviceName      String   // Servicio seleccionado
  professionalName String?  @default("Facundo \"El Maestro\" Rossi") // Barbero
  date             String   // Fecha formato YYYY-MM-DD
  time             String   // Horario formato HH:MM
  status           String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  totalPrice       Float?   @default(0)
  paymentMethod    String?  @default("Efectivo / Transferencia en el local")
  clientEmail      String?
  clientNotes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([status])
}
